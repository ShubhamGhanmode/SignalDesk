# Local development values. Copy to .env before starting Docker Compose.
POSTGRES_PASSWORD=local-signaldesk-postgres
DEMO_PASSWORD=SignalDesk-Local-2026!
DEMO_ACME_API_KEY=acme-local-ingestion-key-change-me-2026
DEMO_NORTHSTAR_API_KEY=northstar-local-ingestion-key-change-me-2026
BRIEF_TOKEN=local-brief-service-token-change-me-2026
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
INGEST_PER_MINUTE=6000

# Optional AI briefs. Leave the model ID empty for deterministic evidence briefs.
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# These overrides are for native Go development. Compose sets service addresses.
# POSTGRES_URL=postgres://signaldesk:local-signaldesk-postgres@localhost:5432/signaldesk?sslmode=disable
